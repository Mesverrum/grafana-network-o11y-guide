# Grafana Cloud → Connections → OpenTelemetry
# One stack, one region. Do not open GC_OTLP_URL in a browser (GET /otlp is 404).
GC_OTLP_URL=https://otlp-gateway-prod-us-central-0.grafana.net/otlp
GC_OTLP_ACCOUNT=123456
GC_OTLP_KEY=glc_replace_me

# Optional: Fleet Management. Creating a pipeline needs an access policy
# with Fleet Management write — the OpenTelemetry token often cannot.
# GC_FM_URL=https://fleet-management-prod-000.grafana.net
# GC_FM_TOKEN=

# Image from docs/install-alloy.md (docker build -f Dockerfile.network-src …).
ALLOY_IMAGE=alloy-network:dev
